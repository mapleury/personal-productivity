# wanei. — local environment configuration
# Copy to .env.local and fill in to enable live AI features.
# Without these keys the app runs fully offline with a local rule-based assistant
# and browser speech synthesis.

# Gemini API key — powers assistant reasoning over your schedule/tasks/goals
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API key — powers natural text-to-speech for the voice assistant
ELEVENLABS_API_KEY=
# Optional voice + model overrides
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
